# =====================================================================
#  La Achirana · Variables de entorno
#  Copia este archivo como ".env" (en la raíz del proyecto) y complétalo.
#  NUNCA subas el .env a GitHub (ya está en .gitignore).
# =====================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
# URL pública con la que se abre la web. En local: http://localhost:3000
# En producción usa tu dominio con https (ej. https://achirana.pe).
PUBLIC_URL=http://localhost:3000
# Orígenes extra permitidos por CORS (separados por coma). Solo si abres el
# frontend desde otro puerto, p. ej. Live Server de VS Code.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- PostgreSQL ---
# Opción A (servidor propio): datos sueltos de PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=Achirana
PGUSER=postgres
PGPASSWORD=coloca_aqui_tu_clave

# --- Seguridad ---
# Genera uno con:  npm run secret
JWT_SECRET=
JWT_EXPIRA_HORAS=8
# true = los clientes (DNI/RUC) deben ingresar además su código de acceso de 6 dígitos.
# Déjalo en false hasta que hayas asignado un código a cada cliente desde el Panel.
CLIENTE_PIN_OBLIGATORIO=false
# Valida el dígito verificador del RUC al registrar/editar clientes.
VALIDAR_DIGITO_RUC=true
# Solo para la PRIMERA vez que la tabla usuarios está vacía: crea este admin.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASS=
ADMIN_INICIAL_NOMBRE=Administrador

# Cuenta del gerente (se crea sola si no hay ningún gerente).
# Si lo dejas vacío, en desarrollo usa gerente@laachirana.pe / Gerente2026#
GERENTE_INICIAL_EMAIL=
GERENTE_INICIAL_PASS=
GERENTE_INICIAL_NOMBRE=Gerente General

# --- Pagos: Yape, Plin y bancos ---
# No se configuran aquí. El administrador registra los números de Yape/Plin,
# su código QR y las cuentas bancarias (BCP, Interbank, BBVA, etc.) en
# Panel de control → Medios de pago. El regante envía la captura de su pago
# y la Junta lo valida en Panel de control → Pagos por validar.

# --- Tarifa ---
# Se usa solo para crear la tarifa inicial; luego se cambia desde el Panel.
TARIFA_M3_INICIAL=0.12

# --- Clima ---
# Umbrales de lluvia diaria (mm) para niveles amarillo, naranja y rojo.
CLIMA_UMBRALES_MM=5,15,30
# Velocidad de la onda de avenida en el río (m/s), mínima y máxima, para estimar la llegada.
CLIMA_VELOCIDAD_MIN=1.5
CLIMA_VELOCIDAD_MAX=3.5
CLIMA_REFRESCO_MIN=60
# true = muestra una tormenta SIMULADA (para presentaciones/pruebas). No se guarda en BD.
CLIMA_SIMULACION=false

# ---------------------------------------------------------------
# Culqi: pago con tarjeta y Yape con confirmación automática
#   Pruebas: crea tu cuenta en https://integ-panel.culqi.com
#   Real:    https://mipanel.culqi.com (requiere cuenta de comercio con RUC)
#   Desarrollo → API Keys: llave pública (pk_...) y secreta (sk_...)
#   Desarrollo → RSA Keys: RSA ID y llave pública RSA (opcional, recomendado)
# Si dejas las llaves vacías, la web usa el MODO DEMOSTRACIÓN (no cobra).
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_RSA_ID=
# Pega la llave RSA en una sola línea, reemplazando los saltos de línea por \n
CULQI_RSA_PUBLIC_KEY=
CULQI_YAPE=true
CULQI_MONTO_MINIMO=1
# Modo demostración (solo funciona si no hay llaves de Culqi). En producción queda apagado.
PAGOS_DEMO=true

# ---------------------------------------------------------------
# Opción B (Render, Railway, Neon…): una sola URL. Si existe, se usa en lugar de PGHOST/PGUSER/…
# DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos
# PGSSL=true   ← solo si tu proveedor exige SSL (la URL externa de Render se detecta sola)


# --- Avisos por correo (microservicio servicio-correo/) ---
# URL del microservicio (en Render: https://achirana-correo.onrender.com). Vacío = sin correos.
CORREO_SERVICIO_URL=
# Clave compartida con el microservicio (en Render se copia sola desde achirana-correo)
CORREO_CLAVE=
# Correo(s) de la Junta que reciben cada pago, separados por coma
NOTIFICAR_PAGOS_A=
# Solo para pruebas locales con un simulador de Culqi (déjalo vacío)
CULQI_API_URL=
